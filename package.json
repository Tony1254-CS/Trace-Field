{
  "name": "trace-field-notebook",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names web,api --prefix-colors green,blue \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "next dev --hostname 0.0.0.0 --port 3000",
    "dev:api": "node --env-file-if-exists=.env.local --import tsx --watch server/src/server.ts",
    "build": "npm run typecheck && npm run build:api && npm run build:web",
    "build:web": "next build",
    "build:api": "tsup server/src/server.ts --format esm --platform node --target node24 --out-dir server/dist --clean",
    "start": "concurrently --kill-others --names web,api --prefix-colors green,blue \"npm:start:web\" \"npm:start:api\"",
    "start:web": "next start --hostname 0.0.0.0 --port 3000",
    "start:api": "node --env-file-if-exists=.env.local server/dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:server": "vitest run server/tests"
  },
  "dependencies": {
    "@hookform/resolvers": "5.2.2",
    "@radix-ui/react-dialog": "1.1.15",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "@tanstack/react-query": "5.105.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cors": "2.8.5",
    "express": "5.3.0",
    "express-rate-limit": "8.3.1",
    "helmet": "8.1.0",
    "lucide-react": "1.64.0",
    "multer": "2.0.2",
    "next": "16.4.3",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.62.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/multer": "2.0.0",
    "@types/node": "24.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/supertest": "6.0.3",
    "concurrently": "9.2.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "supertest": "7.1.4",
    "tailwindcss": "4.3.3",
    "tsup": "8.5.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
